{
  "name": "signing-control",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "observability": {
    "enabled": false
  },
  "vars": {
    "ENABLED": "false",
    "SIGNING_CONTROL_CONFIG_JSON": "{}"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SIGNING_CONTROL_STATE",
        "class_name": "SigningControlRepository"
      }
    ]
  },
  "migrations": [
    {
      "tag": "signing-control-v1",
      "new_sqlite_classes": [
        "SigningControlRepository"
      ]
    }
  ],
  "containers": [
    {
      "class_name": "SigningControlRepository",
      "image": "REVIEWED_IMMUTABLE_IMAGE_REQUIRED",
      "scheduling_policy": "default",
      "instance_type": "standard-1",
      "max_instances": 1,
      "observability": {
        "enabled": false
      }
    }
  ]
}
